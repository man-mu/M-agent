{
    "mcp-servers": [
        {
            "url": "https://mcp.amap.com",
            "sse-endpoint": "/sse?key=${AMAP_MAPS_API_KEY}",
            "description": "高德地图 MCP - 天气、地址解析、POI 搜索、路线规划和距离测量",
            "enabled": true,
            "allowed-tools": [
                "maps_weather",
                "maps_geo",
                "maps_regeo",
                "maps_text_search",
                "maps_around_search",
                "maps_ip_location",
                "maps_direction_driving",
                "maps_direction_walking",
                "maps_direction_bicycling",
                "maps_distance"
            ]
        }
    ]
}
