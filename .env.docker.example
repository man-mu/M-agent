# M-Agent Docker 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 数据库配置 =====
POSTGRES_DB=manmu
POSTGRES_USER=manmu
POSTGRES_PASSWORD=manmu
POSTGRES_PORT=5432

# ===== 服务端口 =====
BACKEND_PORT=8080
FRONTEND_PORT=80

# ===== API Key 管理说明 =====
# API Key 存储在 .local/ 目录下，通过 volume 挂载到容器：
# - .local/model-providers.json → 模型供应商 API Key (DeepSeek, MiniMax, DashScope, Bocha)
# - .local/mcp-keys.json → MCP 服务 API Key (和风天气, 高德地图)
# - .local/mcp-servers.json → MCP 服务器配置（本地开发用）
# - .local/mcp-servers-docker.json → MCP 服务器配置（Docker 用，自动挂载）
#
# 请确保 .local/ 目录下的 key 文件已正确配置后再启动 Docker

# ===== 可选：通过环境变量覆盖（优先级高于文件） =====
# 如果设置了环境变量，会覆盖文件中的值
# DEEPSEEK_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx
# MINIMAX_API_KEY=sk-api-xxx
# QWEATHER_API_KEY=xxx
# AMAP_MAPS_API_KEY=xxx
